<?php
$this->headLink()->appendStylesheet($this->assetUrl('css/express.css', 'ExpressAltText'));
$this->htmlElement('body')->appendAttribute('class', 'express-alt-text');
$this->headTitle('Express Alt Text');
$esc = function ($s) { return htmlspecialchars((string) $s, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8'); };
?>
<h1>Express Alt Text</h1>
<p>Review original image media and edit the native alt text used by Omeka S. Thumbnails generated from the same media are grouped into one record.</p>
<?php if ($notice): ?><p class="express-notice" role="status"><?= $esc($notice) ?></p><?php endif; ?>
<?php if ($error): ?><p class="express-error" role="alert"><?= $esc($error) ?></p><?php endif; ?>
<nav class="express-filters" aria-label="Filter images">
<?php foreach (['all'=>'All images', 'missing'=>'Empty alt text', 'filled'=>'With alt text'] as $key=>$label): ?>
<a <?= $filter === $key ? 'aria-current="page"' : '' ?> href="<?= $esc($this->url('admin/express-alt-text', [], ['query'=>['filter'=>$key]])) ?>"><?= $esc($label) ?></a>
<?php endforeach; ?>
</nav>
<p class="express-hint">An empty alt attribute may be appropriate for decorative images. This list cannot automatically distinguish decorative images from missing descriptions.</p>
<div class="express-list">
<?php foreach ($mediaList as $media): ?>
<article class="express-card">
<div class="express-preview">
<?php
// Media entity is converted to its API representation for standard thumbnail URLs.
$representation = $this->api()->read('media', $media->getId())->getContent();
$thumb = $representation->thumbnailUrl('medium');
?>
<?php if ($thumb): ?><img src="<?= $esc($thumb) ?>" alt="" loading="lazy"><?php else: ?><span>No preview available</span><?php endif; ?>
</div>
<div class="express-content">
<h2><?= $esc($representation->displayTitle() ?: 'Untitled image') ?> <small>#<?= (int) $media->getId() ?></small></h2>
<p><a href="<?= $esc($this->url('admin/id', ['controller'=>'media', 'id'=>$media->getId()])) ?>">Open media record</a></p>
<form method="post" action="<?= $esc($this->url('admin/express-alt-text', [], ['query'=>['page'=>$page, 'filter'=>$filter]])) ?>">
<input type="hidden" name="express_csrf" value="<?= $esc($csrf->getValue()) ?>">
<input type="hidden" name="media_id" value="<?= (int) $media->getId() ?>">
<label for="alt-<?= (int) $media->getId() ?>">Alt text for image #<?= (int) $media->getId() ?></label>
<textarea id="alt-<?= (int) $media->getId() ?>" name="alt_text" rows="3" maxlength="10000"><?= $esc($media->getAltText()) ?></textarea>
<div class="express-actions"><button type="submit">Save alt text</button><span>Leave empty only when appropriate for the image's context.</span></div>
</form>
</div>
</article>
<?php endforeach; ?>
<?php if (!$mediaList): ?><p>No images found on this page.</p><?php endif; ?>
</div>
<nav class="express-pagination" aria-label="Image pages">
<?php if ($page > 1): ?><a href="<?= $esc($this->url('admin/express-alt-text', [], ['query'=>['page'=>$page-1,'filter'=>$filter]])) ?>">Previous page</a><?php endif; ?>
<span>Page <?= (int) $page ?></span>
<?php if (count($mediaList) === 30): ?><a href="<?= $esc($this->url('admin/express-alt-text', [], ['query'=>['page'=>$page+1,'filter'=>$filter]])) ?>">Next page</a><?php endif; ?>
</nav>
