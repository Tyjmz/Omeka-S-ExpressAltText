<script>
(function () {
  'use strict';
  var form = document.getElementById('express-batch-form');
  if (!form) return;
  var cards = Array.prototype.slice.call(form.querySelectorAll('.express-card'));
  var status = document.getElementById('express-changes');
  var saving = false;
  var snapshots = cards.map(function (card) {
    var textarea = card.querySelector('textarea');
    var checkbox = card.querySelector('.express-review input');
    return {alt: textarea.value, reviewed: checkbox.checked, reviewTouched: false};
  });
  function changed() {
    return cards.filter(function (card, i) {
      var textarea = card.querySelector('textarea');
      var checkbox = card.querySelector('.express-review input');
      return textarea.value !== snapshots[i].alt || checkbox.checked !== snapshots[i].reviewed;
    }).length;
  }
  function refresh() {
    cards.forEach(function (card, i) {
      var textarea = card.querySelector('textarea');
      var checkbox = card.querySelector('.express-review input');
      var count = card.querySelector('.express-charcount');
      var state = card.querySelector('.express-status');
      count.textContent = Array.from(textarea.value).length + ' characters';
      checkbox.disabled = !textarea.value.trim();
      if (checkbox.disabled) checkbox.checked = false;
      state.textContent = checkbox.checked ? 'Reviewed' : (checkbox.disabled ? 'Empty alt text' : 'Needs review');
      card.classList.toggle('express-modified', textarea.value !== snapshots[i].alt || checkbox.checked !== snapshots[i].reviewed);
    });
    var n = changed();
    status.textContent = n ? n + ' unsaved record(s) on this page.' : 'No unsaved changes on this page.';
    Array.prototype.forEach.call(form.querySelectorAll('.express-save'), function (button) { button.disabled = n === 0; });
  }
  cards.forEach(function (card, i) {
    var textarea = card.querySelector('textarea');
    var checkbox = card.querySelector('.express-review input');
    var confirmation = card.querySelector('.express-review-confirmed');
    textarea.addEventListener('input', function () {
      confirmation.value = '0';
      if (textarea.value !== snapshots[i].alt) {
        checkbox.checked = false;
      } else if (!snapshots[i].reviewTouched) {
        // Returning to the exact original description preserves its prior review.
        checkbox.checked = snapshots[i].reviewed;
      }
      refresh();
    });
    checkbox.addEventListener('change', function () {
      snapshots[i].reviewTouched = true;
      // A changed description can only be re-approved by an explicit user action.
      confirmation.value = checkbox.checked && textarea.value !== snapshots[i].alt ? '1' : '0';
      refresh();
    });
    var img = card.querySelector('img');
    if (img) img.addEventListener('error', function () {
      if (img.dataset.fallbackSrc) {
        var fallback = img.dataset.fallbackSrc;
        delete img.dataset.fallbackSrc;
        img.src = fallback;
      } else {
        img.hidden = true;
        card.querySelector('.express-no-preview').hidden = false;
      }
    });
  });
  form.addEventListener('submit', function (event) {
    if (!changed()) { event.preventDefault(); return; }
    saving = true;
  });
  window.addEventListener('beforeunload', function (event) {
    if (!saving && changed()) { event.preventDefault(); event.returnValue = ''; }
  });
  refresh();
}());
</script>
