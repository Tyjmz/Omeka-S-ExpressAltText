<div class="express-list">
<?php foreach ($mediaList as $media): ?>
<?php
$id = (int) $media->getId();
$representation = null;
$original = null;
$medium = null;
try {
    $representation = $this->api()->read('media', $id)->getContent();
    if (method_exists($representation, 'originalUrl')) {
        $original = $representation->originalUrl();
    }
    $medium = $representation->thumbnailUrl('medium');
} catch (\Throwable $e) {
    error_log('ExpressAltText preview failed for media ' . $id . ': ' . $e->getMessage());
}
$preview = $original ?: $medium;
// Public item URLs require an actual site association. The dashboard is an admin
// route, so a site URL without an explicit site slug can be unavailable.
$publicItemLinks = [];
try {
    if ($representation && method_exists($representation, 'item')) {
        $parentItem = $representation->item();
        if ($parentItem && method_exists($parentItem, 'sites') && method_exists($parentItem, 'siteUrl')) {
            $parentIsPublic = !method_exists($parentItem, 'isPublic') || $parentItem->isPublic();
            if ($parentIsPublic) {
                foreach ($parentItem->sites() as $site) {
                    if (!method_exists($site, 'slug')) {
                        continue;
                    }
                    $siteSlug = (string) $site->slug();
                    if ($siteSlug === '') {
                        continue;
                    }
                    try {
                        // Explicit site slug avoids reliance on an admin request's site context.
                        $candidate = $parentItem->siteUrl($siteSlug);
                        if (is_string($candidate) && $candidate !== ''
                            && (str_starts_with($candidate, '/') || preg_match('~^https?://~i', $candidate))) {
                            $siteLabel = method_exists($site, 'title') ? (string) $site->title() : $siteSlug;
                            $publicItemLinks[$candidate] = $siteLabel ?: $siteSlug;
                        }
                    } catch (\Throwable $e) {
                        error_log('ExpressAltText public URL for media ' . $id . ' on site ' . $siteSlug . ': ' . $e->getMessage());
                    }
                }
            }
        }
    }
} catch (\Throwable $e) {
    error_log('ExpressAltText site lookup failed for media ' . $id . ': ' . $e->getMessage());
}
$mimeType = method_exists($media, 'getMediaType') ? (string) $media->getMediaType() : '';

$currentAlt = array_key_exists($id, $submitted) ? $submitted[$id] : (string) $media->getAltText();
$isReviewed = trim($currentAlt) !== '' && isset($reviewed[(string) $id]);
?>
